{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Amsterdam",
  "forkProcessing": "enabled",
  "pinDigests": true,
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "semanticCommits": "enabled",
  "automerge": false,
  "enabledManagers": [
    "pep621",
    "github-actions",
    "nix",
    "dockerfile",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ffmpeg in the Containerfile: a tag of FFmpeg's own git and its commit",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG FFMPEG_VERSION=(?<currentValue>n[\\d.]+)\\s+ARG FFMPEG_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "ffmpeg",
      "packageNameTemplate": "https://git.ffmpeg.org/ffmpeg.git",
      "versioningTemplate": "regex:^n(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$"
    },
    {
      "customType": "regex",
      "description": "QuickJS-ng in the Containerfile: a release file per architecture and its sha256",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG QJS_(?:AMD64|ARM64)=(?<currentValue>v[\\d.]+)@sha256:(?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "quickjs-ng/quickjs"
    },
    {
      "customType": "regex",
      "description": "The BuildKit image a release on opencommit.eu builds in",
      "managerFilePatterns": [
        "/(^|/)\\.forgejo/workflows/container\\.yml$/"
      ],
      "matchStrings": [
        "BUILDKIT: (?<depName>moby/buildkit):(?<currentValue>v[\\d.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "groupName": "Python packages",
      "addLabels": [
        "python"
      ]
    },
    {
      "description": "Dev tools are pinned to an exact version; the other Python packages keep their range and are pinned by uv.lock",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "A new Python package version waits three days before its pull request, whose tests run on the pi",
      "matchDatasources": [
        "pypi"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The Containerfile's base images, pinned to a digest",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Container images",
      "addLabels": [
        "container"
      ]
    },
    {
      "description": "Nix updates run monthly",
      "matchManagers": [
        "nix"
      ],
      "schedule": [
        "* 0-5 1-7 * 1"
      ],
      "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
          "* 0-5 1-7 * 1"
        ]
      }
    }
  ]
}
