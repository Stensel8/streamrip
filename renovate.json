{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Amsterdam",
  "forkProcessing": "enabled",
  "pinDigests": true,
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "semanticCommits": "enabled",
  "automerge": false,
  "enabledManagers": [
    "pep621",
    "github-actions",
    "nix",
    "dockerfile"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "groupName": "Python packages",
      "addLabels": [
        "python"
      ]
    },
    {
      "description": "Dev tools are pinned to an exact version; the other Python packages keep their range and are pinned by uv.lock",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "The Containerfile's base images, pinned to a digest",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Container images",
      "addLabels": [
        "container"
      ]
    },
    {
      "description": "Nix updates run monthly",
      "matchManagers": [
        "nix"
      ],
      "schedule": [
        "* 0-5 1-7 * 1"
      ],
      "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
          "* 0-5 1-7 * 1"
        ]
      }
    }
  ]
}
