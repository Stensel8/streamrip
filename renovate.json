{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Amsterdam",
  "forkProcessing": "enabled",
  "pinDigests": true,
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "semanticCommits": "enabled",
  "automerge": false,
  "enabledManagers": [
    "pep621",
    "github-actions",
    "nix",
    "dockerfile",
    "npm",
    "nodenv",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ffmpeg in the Containerfile: a tag and its commit, looked up on FFmpeg's GitHub mirror, which Patchbot can reach where git.ffmpeg.org times out",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG FFMPEG_VERSION=(?<currentValue>n[\\d.]+)\\s+ARG FFMPEG_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ffmpeg",
      "packageNameTemplate": "FFmpeg/FFmpeg",
      "versioningTemplate": "regex:^n(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$"
    },
    {
      "customType": "regex",
      "description": "QuickJS-ng in the Containerfile: a release file per architecture and its sha256",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG QJS_(?:AMD64|ARM64)=(?<currentValue>v[\\d.]+)@sha256:(?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "quickjs-ng/quickjs"
    },
    {
      "customType": "regex",
      "description": "The BuildKit image a release on opencommit.eu builds in",
      "managerFilePatterns": [
        "/(^|/)\\.forgejo/workflows/container\\.yml$/"
      ],
      "matchStrings": [
        "BUILDKIT: (?<depName>moby/buildkit):(?<currentValue>v[\\d.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "uv in install.sh and install.ps1: a release and the sha256 of its installer",
      "managerFilePatterns": [
        "/(^|/)install\\.(sh|ps1)$/"
      ],
      "matchStrings": [
        "UV_INSTALLER\\s*=\\s*\"?(?<currentValue>[\\d.]+)@sha256:(?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "astral-sh/uv"
    }
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "groupName": "Python packages",
      "addLabels": [
        "python"
      ]
    },
    {
      "description": "Dev tools are pinned to an exact version; the other Python packages keep their range and are pinned by uv.lock",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "A new Python package version waits three days before its pull request, whose tests run on the pi",
      "matchDatasources": [
        "pypi"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The Containerfile's base images, pinned to a digest",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Container images",
      "addLabels": [
        "container"
      ]
    },
    {
      "description": "Nix updates run monthly",
      "matchManagers": [
        "nix"
      ],
      "schedule": [
        "* 0-5 1-7 * 1"
      ],
      "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
          "* 0-5 1-7 * 1"
        ]
      }
    },
    {
      "description": "uv everywhere at once: the installers, the image's uv and the build backend",
      "matchPackageNames": [
        "astral-sh/uv",
        "ghcr.io/astral-sh/uv",
        "uv_build"
      ],
      "groupName": "uv"
    },
    {
      "description": "yt-dlp takes its solver script only at the version it was released with: bumped together",
      "matchPackageNames": [
        "yt-dlp",
        "yt-dlp-ejs"
      ],
      "groupName": "yt-dlp"
    },
    {
      "description": "The web interface (frontend/): its packages together. CI fails until `npm run build` is committed with them",
      "matchManagers": [
        "npm",
        "nodenv"
      ],
      "groupName": "Web interface",
      "addLabels": [
        "frontend"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "svelte-check takes TypeScript 5 and 6 only, for now",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Node in CI: its long-term releases (the even ones) only",
      "matchManagers": [
        "nodenv"
      ],
      "allowedVersions": "/^\\d*[02468](\\.|$)/"
    }
  ],
  "hostRules": [
    {
      "description": "opencommit.eu is a Forgejo: its actions (the checkout mirror) are looked up with its tags",
      "matchHost": "opencommit.eu",
      "hostType": "forgejo"
    }
  ]
}
