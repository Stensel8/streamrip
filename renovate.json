{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Amsterdam",
  "forkProcessing": "enabled",
  "pinDigests": true,
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "semanticCommits": "enabled",
  "enabledManagers": [
    "poetry",
    "github-actions",
    "nix"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "matchManagers": [
        "poetry"
      ],
      "groupName": "Python packages",
      "addLabels": [
        "python"
      ]
    },
    {
      "description": "Minor, patch and digest updates merge themselves once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates wait for a human",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Nix updates run monthly with the shared automerge policy",
      "matchManagers": [
        "nix"
      ],
      "schedule": [
        "* 0-5 1-7 * 1"
      ],
      "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
          "* 0-5 1-7 * 1"
        ]
      }
    }
  ]
}
